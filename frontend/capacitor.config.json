{
  "appId": "ai.karigar.app",
  "appName": "Karigar AI",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SpeechRecognition": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com",
        "phone"
      ]
    }
  }
}
