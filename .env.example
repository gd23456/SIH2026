# ---------------------------------------------------------------------------
# Karigar AI — environment template
#
#   cp .env.example backend/.env
#
# EVERYTHING WORKS WITHOUT A KEY. With no GEMINI_API_KEY the backend returns
# realistic, keyword-aware mock AI responses, so the demo never breaks on stage.
# Check which mode you're in:  curl http://localhost:8000/api/health
# ---------------------------------------------------------------------------

# --- Google Gemini (free tier) -------------------------------------------
# Get a key: https://aistudio.google.com/app/apikey
# Leave BLANK to run in mock mode.
GEMINI_API_KEY=

# Model used for listing generation + price reasoning.
# The backend auto-falls-back through a candidate list if this one is
# unavailable on your key, so you rarely need to change it.
GEMINI_MODEL=gemini-2.5-flash

# --- Demo safety ----------------------------------------------------------
# "1" = force mock mode even when a key is present.
# Turn this ON for the stage demo if the venue wifi is unreliable.
FORCE_MOCK=0

# --- Networking -----------------------------------------------------------
# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://localhost

# PUBLIC_BASE_URL controls the storefront + QR-code links.
# Leave BLANK and the backend derives it from the incoming request host —
# this is what makes the QR code work over your laptop hotspot on demo day.
# Only set it when you deploy to a real domain.
PUBLIC_BASE_URL=

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./karigar.db
