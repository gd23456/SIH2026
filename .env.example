# ---------------------------------------------------------------------------
# Karigar AI — environment template
#
#   cp .env.example backend/.env
#
# EVERYTHING WORKS WITHOUT A KEY. With no GEMINI_API_KEY the backend returns
# realistic, keyword-aware mock AI responses, so the demo never breaks on stage.
# Check which mode you're in:  curl http://localhost:8000/api/health
# ---------------------------------------------------------------------------

# --- Google Gemini (free tier) -------------------------------------------
# Get a key: https://aistudio.google.com/app/apikey
# Leave BLANK to run in mock mode.
GEMINI_API_KEY=

# Model used for listing generation + price reasoning. "gemini-flash-latest"
# auto-tracks the current flash model (older pinned names like gemini-2.5-flash
# stop being served to new keys). The backend also auto-falls-back through a
# candidate list, so you rarely need to change this.
GEMINI_MODEL=gemini-flash-latest

# --- Demo safety ----------------------------------------------------------
# "1" = force mock mode even when a key is present.
# Turn this ON for the stage demo if the venue wifi is unreliable.
FORCE_MOCK=0

# --- Networking -----------------------------------------------------------
# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://localhost

# PUBLIC_BASE_URL controls the storefront + QR-code links.
# Leave BLANK and the backend derives it from the incoming request host —
# this is what makes the QR code work over your laptop hotspot on demo day.
# Only set it when you deploy to a real domain.
PUBLIC_BASE_URL=

# --- Database -------------------------------------------------------------
# A relative sqlite path is resolved against backend/, NOT your shell's working
# directory — uvicorn is normally launched from the repo root, and the database
# should not land there. Absolute paths are used as given.
DATABASE_URL=sqlite:///./karigar.db

# --- Environment -----------------------------------------------------------
# "production" refuses development-only providers (the 3D test model).
APP_ENV=development

# --- 3D product models ------------------------------------------------------
# Six capture views -> a GLB the app and storefront show in 3D.
#   local    Self-hosted Hunyuan3D-2mv worker (model3d_server/) — free; runs on
#            an Apple Silicon Mac (16 GB+) or any GPU box. Start it with
#            `make model3d`, then set MODEL3D_LOCAL_URL below.
#   meshy    Meshy multi-image-to-3D (hosted, paid). Needs MESHY_API_KEY.
#            Key: https://www.meshy.ai/developers/keys — keep it here, server-side
#            only; the app never sees it. ~30 credits per successful model.
#   mock     Local test model (a textured box). Development only; labelled
#            "Test model" everywhere; refused when APP_ENV=production.
#   disabled Photos are still captured and shown; no 3D is generated.
# Blank = meshy if MESHY_API_KEY is set, otherwise disabled.
MODEL3D_PROVIDER=
MESHY_API_KEY=
MESHY_AI_MODEL=latest
MODEL3D_LOCAL_URL=http://127.0.0.1:8100
# Shared secret; set the same value when starting the worker.
MODEL3D_LOCAL_TOKEN=
# Give up on a model not finished in this many seconds.
MODEL3D_TIMEOUT_S=1800
# Photos + models of products never published are deleted after N days.
MODEL3D_RETENTION_DAYS=7
# Where uploads and models are stored. Use a persistent volume in production.
MEDIA_DIR=./media
